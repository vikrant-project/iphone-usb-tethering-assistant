<Page
    x:Class="TetherAssistant.Windows.Views.DiagnosticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:TetherAssistant.Windows.Models"
    xmlns:vm="using:TetherAssistant.Windows.ViewModels">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="20" MaxWidth="1000" HorizontalAlignment="Left">
            <TextBlock Text="Connection Diagnostics" FontSize="24" FontWeight="Bold" />

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Text="{x:Bind ViewModel.OverallSummary, Mode=OneWay}"
                               FontSize="16" FontWeight="SemiBold" />

                    <Button Content="Run Diagnostics"
                            Command="{x:Bind ViewModel.RunDiagnosticsCommand}"
                            Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </Border>

            <!-- Results List -->
            <ItemsControl ItemsSource="{x:Bind ViewModel.Stages, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:DiagnosticStageResult">
                        <Border Margin="0,0,0,12"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="16">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <FontIcon Grid.Column="0" Glyph="&#xE73E;" Foreground="#10B981"
                                          FontSize="20" VerticalAlignment="Center" />

                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="{x:Bind StageName}" FontWeight="SemiBold" FontSize="14" />
                                    <TextBlock Text="{x:Bind Details}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                                    <TextBlock Text="{x:Bind TroubleshootingAdvice}"
                                               Visibility="{x:Bind TroubleshootingAdvice, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}"
                                               Foreground="#F59E0B" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0" />
                                </StackPanel>

                                <TextBlock Grid.Column="2" Text="{x:Bind LatencyMilliseconds}"
                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>

