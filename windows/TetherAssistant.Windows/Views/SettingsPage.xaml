<Page
    x:Class="TetherAssistant.Windows.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:TetherAssistant.Windows.ViewModels">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="20" MaxWidth="1000" HorizontalAlignment="Left">
            <TextBlock Text="Settings &amp; Maintenance" FontSize="24" FontWeight="Bold" />

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Text="DATA &amp; PRIVACY" FontSize="12" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <Button Content="Wipe Session History"
                            Command="{x:Bind ViewModel.ClearHistoryCommand}" />

                    <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                               Foreground="#10B981" FontSize="13" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>

