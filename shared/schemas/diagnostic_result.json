{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DiagnosticResult",
  "type": "object",
  "properties": {
    "timestampUtc": { "type": "string", "format": "date-time" },
    "isHealthy": { "type": "boolean" },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "stage": { "type": "string" },
          "stageName": { "type": "string" },
          "severity": { "type": "string", "enum": ["Pass", "Warning", "Failure"] },
          "latencyMilliseconds": { "type": "number", "minimum": 0.0 },
          "details": { "type": ["string", "null"] },
          "troubleshootingAdvice": { "type": ["string", "null"] }
        },
        "required": ["stage", "stageName", "severity", "latencyMilliseconds"]
      }
    },
    "overallSummary": { "type": "string" }
  },
  "required": ["timestampUtc", "isHealthy", "stages", "overallSummary"]
}

